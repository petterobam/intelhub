# ── IntelHub Environment Variables ──────────────────────────────────
# Copy this file to .env and adjust values as needed.

# Flask
FLASK_ENV=development          # development | production
SECRET_KEY=change-me-to-a-random-string

# Database (default: sqlite:///data/intel_hub.db)
# DATABASE_URL=sqlite:///data/intel_hub.db

# Data directories (override if you need custom paths)
# DATA_DIR=data
# RAW_DIR=data/raw
# PROCESSED_DIR=data/processed
# REPORTS_DIR=data/reports
# LOGS_DIR=data/logs

# Scheduler
SCHEDULER_API_ENABLED=true

# Default delivery target for task results: local | feishu
DEFAULT_DELIVER_TO=local

# Feishu webhook (used when deliver_to=feishu)
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
